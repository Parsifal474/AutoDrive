<Window x:Class="AutoDrive.Views.PaymentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoDrive.Converters"
        Title="Платёж" Height="450" Width="450" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Данные платежа" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Курсант -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Курсант:" Width="80" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Students}" DisplayMemberPath="LastName" 
                      SelectedValuePath="Id" SelectedValue="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}"
                      Width="250"/>
        </StackPanel>

        <!-- Сумма -->
        <Grid Grid.Row="2" Margin="0,5">
            <TextBox x:Name="AmountBox" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Сумма *" IsHitTestVisible="False" Foreground="Gray"
                       Visibility="{Binding ElementName=AmountBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"
                       Margin="5,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Дата платежа -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Дата:" Width="80" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding PaymentDate}" Width="250"/>
        </StackPanel>

        <!-- Описание -->
        <Grid Grid.Row="4" Margin="0,5">
            <TextBox x:Name="DescriptionBox" Text="{Binding Description}"/>
            <TextBlock Text="Описание" IsHitTestVisible="False" Foreground="Gray"
                       Visibility="{Binding ElementName=DescriptionBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"
                       Margin="5,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Тип оплаты -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Тип оплаты:" Width="80" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}" Width="250"/>
        </StackPanel>

        <CheckBox Grid.Row="6" Content="Часть рассрочки" IsChecked="{Binding IsInstallment}" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>