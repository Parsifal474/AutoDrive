<Window x:Class="AutoDrive.Views.LessonEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Занятие" Height="450" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Данные занятия" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Students}" DisplayMemberPath="LastName" SelectedValuePath="Id"
                  SelectedValue="{Binding StudentId}" Margin="0,5" Tag="Курсант *"/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding Instructors}" DisplayMemberPath="LastName" SelectedValuePath="Id"
                  SelectedValue="{Binding InstructorId}" Margin="0,5" Tag="Инструктор *"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Vehicles}" DisplayMemberPath="LicensePlate" SelectedValuePath="Id"
                  SelectedValue="{Binding VehicleId}" Margin="0,5" Tag="Автомобиль *"/>
        <DatePicker Grid.Row="4" SelectedDate="{Binding StartTime}" Margin="0,5" Tag="Дата"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <TextBox Text="{Binding StartTime.Hour}" Width="40" Margin="0,5,5,5" Tag="Час"/>
            <TextBlock Text=":" VerticalAlignment="Center"/>
            <TextBox Text="{Binding StartTime.Minute}" Width="40" Margin="5,5,5,5" Tag="Мин"/>
            <TextBlock Text="–" Margin="10,0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding EndTime.Hour}" Width="40" Margin="5,5,5,5" Tag="Час кон."/>
            <TextBlock Text=":" VerticalAlignment="Center"/>
            <TextBox Text="{Binding EndTime.Minute}" Width="40" Margin="5,5,5,5" Tag="Мин кон."/>
        </StackPanel>
        <TextBox Grid.Row="6" Text="{Binding Note}" Margin="0,5" Tag="Примечание" AcceptsReturn="True" Height="60"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>