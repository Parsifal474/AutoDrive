<Window x:Class="AutoDrive.Views.StudentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoDrive.Converters"
        Title="Курсант" Height="500" Width="450" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование курсанта" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Фамилия -->
        <Grid Grid.Row="1" Margin="0,5">
            <TextBox x:Name="LastNameBox" Text="{Binding LastName}"/>
            <TextBlock Text="Фамилия *" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=LastNameBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Имя -->
        <Grid Grid.Row="2" Margin="0,5">
            <TextBox x:Name="FirstNameBox" Text="{Binding FirstName}"/>
            <TextBlock Text="Имя *" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=FirstNameBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Отчество -->
        <Grid Grid.Row="3" Margin="0,5">
            <TextBox x:Name="MiddleNameBox" Text="{Binding MiddleName}"/>
            <TextBlock Text="Отчество" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=MiddleNameBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Телефон -->
        <Grid Grid.Row="4" Margin="0,5">
            <TextBox x:Name="PhoneBox" Text="{Binding Phone}"/>
            <TextBlock Text="Телефон *" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=PhoneBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Email -->
        <Grid Grid.Row="5" Margin="0,5">
            <TextBox x:Name="EmailBox" Text="{Binding Email}"/>
            <TextBlock Text="Email" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=EmailBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Статус -->
        <Grid Grid.Row="6" Margin="0,5">
            <TextBox x:Name="StatusBox" Text="{Binding Status}"/>
            <TextBlock Text="Статус" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=StatusBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- № договора -->
        <Grid Grid.Row="7" Margin="0,5">
            <TextBox x:Name="ContractBox" Text="{Binding ContractNumber}"/>
            <TextBlock Text="№ договора" IsHitTestVisible="False" Foreground="Gray" 
                       VerticalAlignment="Center" Margin="5,0,0,0"
                       Visibility="{Binding ElementName=ContractBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>