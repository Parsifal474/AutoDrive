<Window x:Class="AutoDrive.Views.VehicleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автомобиль" Height="500" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Данные автомобиля" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBox Grid.Row="1" Text="{Binding Brand}" Margin="0,5" Tag="Марка *"/>
        <TextBox Grid.Row="2" Text="{Binding Model}" Margin="0,5" Tag="Модель *"/>
        <TextBox Grid.Row="3" Text="{Binding LicensePlate}" Margin="0,5" Tag="Госномер *"/>
        <TextBox Grid.Row="4" Text="{Binding Year}" Margin="0,5" Tag="Год выпуска"/>
        <DatePicker Grid.Row="5" SelectedDate="{Binding InsuranceExpiry}" Margin="0,5" Tag="Срок ОСАГО/КАСКО"/>
        <DatePicker Grid.Row="6" SelectedDate="{Binding InspectionExpiry}" Margin="0,5" Tag="Срок диагностической карты"/>
        <DatePicker Grid.Row="7" SelectedDate="{Binding MaintenanceDue}" Margin="0,5" Tag="Дата следующего ТО"/>
        <ComboBox Grid.Row="8" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="0,5" Tag="Статус"/>
        <ComboBox Grid.Row="9" ItemsSource="{Binding Instructors}" DisplayMemberPath="LastName" 
                  SelectedValuePath="Id" SelectedValue="{Binding InstructorId}" Margin="0,5" Tag="Закреплённый инструктор"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>