<Window x:Class="AutoDrive.Views.InstructorEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инструктор" Height="450" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Данные инструктора" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBox Grid.Row="1" Text="{Binding LastName}" Margin="0,5" Tag="Фамилия *"/>
        <TextBox Grid.Row="2" Text="{Binding FirstName}" Margin="0,5" Tag="Имя *"/>
        <TextBox Grid.Row="3" Text="{Binding MiddleName}" Margin="0,5" Tag="Отчество"/>
        <TextBox Grid.Row="4" Text="{Binding Phone}" Margin="0,5" Tag="Телефон *"/>
        <TextBox Grid.Row="5" Text="{Binding Email}" Margin="0,5" Tag="Email"/>
        <TextBox Grid.Row="6" Text="{Binding HourlyRate}" Margin="0,5" Tag="Ставка за час (руб.)"/>
        <CheckBox Grid.Row="7" Content="Активен" IsChecked="{Binding IsActive}" Margin="0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>